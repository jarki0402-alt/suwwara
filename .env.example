# Copy this to .env (which is gitignored) and fill in a real value.
# Used by docker-compose.yml for the Postgres container + the backend's DATABASE_URL.
POSTGRES_PASSWORD=change-me

# First-boot admin (sign-in is required for the whole app). Leave ADMIN_PASSWORD empty to have a random one
# printed once in `docker compose logs backend`; either way it must be changed at first sign-in if generated.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Admin dashboard's Google Cloud bill estimate. The only paid line on this VM is data sent to Cloudflare ("Carrier
# Peering", not covered by the 200 GiB free Standard egress): Rp per GiB, and how much the bill runs above the bytes
# this server counts (calibrated Oct 2026: 4.22 GiB billed vs 3.92 counted). Re-check against a billing CSV now and then.
EGRESS_RP_PER_GIB=1450
EGRESS_OVERHEAD=1.08

# Music videos (Now Playing → Lagu | Video). Set to false to turn the feature off entirely if the server feels the
# load: the button disappears and /api/video refuses. On by default.
VIDEO_ENABLED=true
