# Copy this to .env (which is gitignored) and fill in a real value.
# Used by docker-compose.yml for the Postgres container + the backend's DATABASE_URL.
POSTGRES_PASSWORD=change-me

# First-boot admin (sign-in is required for the whole app). Leave ADMIN_PASSWORD empty to have a random one
# printed once in `docker compose logs backend`; either way it must be changed at first sign-in if generated.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Admin dashboard's "Kuota bulan ini" reference point (GB), just a heads-up display — nothing is throttled or
# blocked past it. Only this app's own audio bytes count towards it, so treat it as an approximation of whatever
# your cloud provider actually meters; check its current egress quota/pricing and adjust. Default 200 if unset.
BANDWIDTH_QUOTA_GB=200
